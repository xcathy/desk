:root {
    top: 0%;
    left: 0%;
    right: 0%;
    bottom: 0%;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
}

#menu {
    top: 0%;
    left: 0%;
    right: 0%;
    bottom: 0%;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    opacity: 0.8;
    flex-wrap: wrap;
    margin-right: 0%;
    margin-left: 0%;
    background-color: rgb(51, 51, 51);
    display: flex;
    margin-top: 0%;
    margin-bottom: 0%;
    width: 100%;
}

#dialogue {
    top: auto;
    left: auto;
    right: 0%;
    bottom: 0%;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    opacity: 0.8;
    flex-wrap: wrap;
    margin-right: 2%;
    margin-left: 2%;
    background-color: rgb(51, 51, 51);
    display: flex;
    width: 80%;
    height: 30%;
    margin-top: 2%;
    margin-bottom: 2%;
    position: absolute;
    font-size: 60px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
}

#icon {
    top: auto;
    left: 0%;
    right: auto;
    bottom: 0%;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    opacity: 0.8;
    flex-wrap: wrap;
    margin-right: 2%;
    margin-left: 2%;
    background-color: rgb(51, 51, 51);
    display: flex;
    width: 17%;
    height: auto;
    margin-top: 2%;
    margin-bottom: 2%;
    position: absolute;
    aspect-ratio: 1;
    flex-basis: auto;
    background-image: url("project://database/Assets/Sprites/UI/icon1%201.png?fileID=2800000&guid=138d55955b67e4f4a99fa96848fe6f2f&type=3#icon1 1");
}

#STARTOVER {
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    opacity: 1;
    flex-wrap: wrap;
    margin-right: 3%;
    margin-left: 3%;
    background-color: rgb(152, 152, 152);
    display: flex;
    width: 80%;
    height: auto;
    margin-top: 3%;
    margin-bottom: 3%;
    position: relative;
    aspect-ratio: 3;
    flex-basis: auto;
    background-image: none;
    font-size: 60px;
    border-top-left-radius: 84px;
    border-top-right-radius: 84px;
    border-bottom-right-radius: 84px;
    border-bottom-left-radius: 84px;
    -unity-font-style: normal;
}

