#menu {
    top: 0%;
    left: 0%;
    right: 0%;
    bottom: 0%;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    opacity: 0.8;
    flex-wrap: wrap;
    margin-right: 0%;
    margin-left: 0%;
    background-color: rgb(51, 51, 51);
    display: flex;
    margin-top: 0%;
    margin-bottom: 0%;
    width: 100%;
}

.menuBtn {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    align-items: center;
    justify-content: center;
    align-self: center;
    flex-wrap: wrap;
    width: 60%;
    margin-top: 5%;
    margin-right: 5%;
    margin-bottom: 5%;
    margin-left: 5%;
}

#dialogue {
    position: absolute;
    bottom: 0%;
    align-items: center;
    align-self: center;
    justify-content: center;
    align-content: center;
    width: 100%;
    height: 40%;
    padding-top: 0%;
    padding-right: 5%;
    padding-bottom: 0%;
    padding-left: 5%;
    margin-top: 0%;
    margin-right: 0%;
    margin-bottom: 0%;
    margin-left: 0%;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

#box {
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    opacity: 0.8;
    flex-wrap: wrap;
    margin-right: 0%;
    margin-left: 5%;
    background-color: rgb(51, 51, 51);
    display: flex;
    width: 80%;
    height: 80%;
    margin-top: 0%;
    margin-bottom: 0%;
    position: relative;
    font-size: 60px;
    border-top-left-radius: 27px;
    border-top-right-radius: 27px;
    border-bottom-right-radius: 27px;
    border-bottom-left-radius: 27px;
    -unity-text-generator: standard;
    flex-direction: column;
}

#icon {
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    opacity: 0.8;
    flex-wrap: wrap;
    margin-right: 0%;
    margin-left: 0%;
    background-color: rgb(51, 51, 51);
    display: flex;
    width: auto;
    height: 80%;
    margin-top: 0%;
    margin-bottom: 0%;
    position: relative;
    aspect-ratio: 1;
    flex-basis: auto;
    background-image: url("project://database/Assets/Sprites/UI/icon1%201.png?fileID=2800000&guid=138d55955b67e4f4a99fa96848fe6f2f&type=3#icon1 1");
    border-top-left-radius: 69px;
    border-top-right-radius: 69px;
    border-bottom-right-radius: 69px;
    border-bottom-left-radius: 69px;
}

#text {
    position: absolute;
    flex-direction: column;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    align-self: center;
    align-content: center;
    width: 80%;
    height: 80%;
    top: 0%;
    left: 0%;
    margin-top: 3%;
    margin-right: 7%;
    margin-bottom: 3%;
    margin-left: 7%;
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&guid=e3265ab4bf004d28a9537516768c1c75&type=3#LiberationSans");
    text-overflow: ellipsis;
}

#space {
    right: 0%;
    bottom: 0%;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    position: absolute;
    width: 15%;
    aspect-ratio: 1;
    flex-direction: column;
    margin-top: 0%;
    margin-right: 3%;
    margin-bottom: 0%;
    margin-left: 3%;
}

#magnify {
    display: none;
    position: absolute;
    top: 0%;
    left: 0%;
    right: 0%;
    bottom: 0%;
    background-color: rgb(38, 38, 38);
    opacity: 0.9;
    transition: display 0.3s ease-in-out;
}

#magnify.show {
    display: flex;
    position: absolute;
    top: 0%;
    left: 0%;
    right: 0%;
    bottom: 0%;
    background-color: rgb(38, 38, 38);
    opacity: 0.9;
    transition: display 0.3s ease-in-out;
}
