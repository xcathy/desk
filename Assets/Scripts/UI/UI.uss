:root {
    top: 0%;
    left: 0%;
    right: 0%;
    bottom: 0%;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
}

#items {
    position: absolute;
    top: 0;
    justify-content: center;
    align-self: center;
    align-content: center;
    width: 80%;
    background-color: rgb(67, 67, 67);
    opacity: 0.8;
    -unity-text-align: upper-center;
    white-space: pre-wrap;
    text-overflow: ellipsis;
    -unity-background-image-tint-color: rgb(72, 72, 72);
    background-image: none;
    -unity-text-auto-size: none;
    font-size: 30px;
    align-items: stretch;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    aspect-ratio: auto;
    height: 20%;
    flex-direction: row;
}

.slot {
    position: relative;
    top: auto;
    justify-content: center;
    align-self: center;
    align-content: center;
    width: auto;
    background-color: rgb(31, 31, 31);
    opacity: 0.8;
    -unity-text-align: upper-center;
    white-space: pre-wrap;
    text-overflow: ellipsis;
    -unity-background-image-tint-color: rgb(72, 72, 72);
    background-image: none;
    -unity-text-auto-size: none;
    font-size: 30px;
    align-items: center;
    margin-top: 5%;
    margin-right: 5%;
    margin-bottom: 5%;
    margin-left: 5%;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    aspect-ratio: 1;
    height: auto;
    flex-direction: column;
    flex-wrap: wrap;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

#menu {
    top: 0%;
    left: 0%;
    right: 0%;
    bottom: 0%;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    opacity: 0.8;
    flex-wrap: wrap;
    margin-right: 0%;
    margin-left: 0%;
    background-color: rgb(51, 51, 51);
    display: flex;
    margin-top: 0%;
    margin-bottom: 0%;
    width: 100%;
}

#STARTOVER {
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    opacity: 1;
    flex-wrap: wrap;
    margin-right: 3%;
    margin-left: 3%;
    background-color: rgb(152, 152, 152);
    display: flex;
    width: 80%;
    height: auto;
    margin-top: 3%;
    margin-bottom: 3%;
    position: relative;
    aspect-ratio: 3;
    flex-basis: auto;
    background-image: none;
    font-size: 60px;
    border-top-left-radius: 84px;
    border-top-right-radius: 84px;
    border-bottom-right-radius: 84px;
    border-bottom-left-radius: 84px;
    -unity-font-style: normal;
}

#RESUME {
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    opacity: 1;
    flex-wrap: wrap;
    margin-right: 3%;
    margin-left: 3%;
    background-color: rgb(152, 152, 152);
    display: flex;
    width: 80%;
    height: auto;
    margin-top: 3%;
    margin-bottom: 3%;
    position: relative;
    aspect-ratio: 3;
    flex-basis: auto;
    background-image: none;
    font-size: 60px;
    border-top-left-radius: 84px;
    border-top-right-radius: 84px;
    border-bottom-right-radius: 84px;
    border-bottom-left-radius: 84px;
    -unity-font-style: normal;
}

#EXIT {
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    opacity: 1;
    flex-wrap: wrap;
    margin-right: 3%;
    margin-left: 3%;
    background-color: rgb(152, 152, 152);
    display: flex;
    width: 80%;
    height: auto;
    margin-top: 3%;
    margin-bottom: 3%;
    position: relative;
    aspect-ratio: 3;
    flex-basis: auto;
    background-image: none;
    font-size: 60px;
    border-top-left-radius: 84px;
    border-top-right-radius: 84px;
    border-bottom-right-radius: 84px;
    border-bottom-left-radius: 84px;
    -unity-font-style: normal;
}

#dialogue {
    position: absolute;
    bottom: 0%;
    align-items: center;
    align-self: center;
    justify-content: center;
    align-content: center;
    width: 100%;
    height: 40%;
    padding-top: 0%;
    padding-right: 5%;
    padding-bottom: 0%;
    padding-left: 5%;
    margin-top: 0%;
    margin-right: 0%;
    margin-bottom: 0%;
    margin-left: 0%;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

#box {
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    opacity: 0.8;
    flex-wrap: wrap;
    margin-right: 0%;
    margin-left: 5%;
    background-color: rgb(51, 51, 51);
    display: flex;
    width: 80%;
    height: 80%;
    margin-top: 0%;
    margin-bottom: 0%;
    position: relative;
    font-size: 60px;
    border-top-left-radius: 27px;
    border-top-right-radius: 27px;
    border-bottom-right-radius: 27px;
    border-bottom-left-radius: 27px;
    -unity-text-generator: standard;
    flex-direction: column;
}

#icon {
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    opacity: 0.8;
    flex-wrap: wrap;
    margin-right: 0%;
    margin-left: 0%;
    background-color: rgb(51, 51, 51);
    display: flex;
    width: auto;
    height: 80%;
    margin-top: 0%;
    margin-bottom: 0%;
    position: relative;
    aspect-ratio: 1;
    flex-basis: auto;
    background-image: url("project://database/Assets/Sprites/UI/icon1%201.png?fileID=2800000&guid=138d55955b67e4f4a99fa96848fe6f2f&type=3#icon1 1");
    border-top-left-radius: 69px;
    border-top-right-radius: 69px;
    border-bottom-right-radius: 69px;
    border-bottom-left-radius: 69px;
}

#text {
    position: absolute;
    flex-direction: column;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    align-self: center;
    align-content: center;
    width: 80%;
    height: 80%;
    top: 0%;
    left: 0%;
    margin-top: 3%;
    margin-right: 7%;
    margin-bottom: 3%;
    margin-left: 7%;
    font-size: 90px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=8e224a1ed032b7f4b926e3306804102e&type=3#NotInter-Regular");
    text-overflow: ellipsis;
}
